{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": ["<rootDir>/setup-environment.ts"],
  "testEnvironment": "node",
  "testRegex": ".*(e2e-spec|test-database.spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
